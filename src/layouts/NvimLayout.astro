---
import "../styles/global.css";
import FileTree from "../components/nvim/FileTree.astro";
import StatusBar from "../components/nvim/StatusBar.astro";
import ScanlinesOverlay from "../components/nvim/ScanlinesOverlay.astro";
import TelescopeModal from "../components/nvim/TelescopeModal.astro";

interface Props {
  title?: string;
  activeFile: string;
  fileType?: string;
  mode?: string;
}

const {
  title = "Wish (PETER)",
  activeFile,
  fileType = "markdown",
  mode = "NORMAL",
} = Astro.props;

const tildeCount = 60;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Defaults: theme + start in buffer-focus (cursor lives in the buffer).
      document.documentElement.classList.add("buffer-focus");
      try {
        var t = localStorage.getItem("theme");
        if (t === "light") document.documentElement.classList.add("light");
        else if (t === "storm") document.documentElement.classList.add("storm");
      } catch (_) {}
    </script>
  </head>
  <body class="bg-bg text-fg font-mono">
    <ScanlinesOverlay />
    <div class="flex h-screen flex-col">
      <div class="flex flex-1 overflow-hidden">
        <aside class="w-[280px] shrink-0 bg-bg-dark border-r border-border overflow-y-auto">
          <FileTree activeFile={activeFile} />
        </aside>
        <main class="flex-1 overflow-auto">
          <slot />
          <div class="vim-tildes pt-1 pb-16 pl-4" aria-hidden="true">
            {Array.from({ length: tildeCount }).map(() => (<div>~</div>))}
          </div>
        </main>
      </div>
      <StatusBar mode={mode} fileType={fileType} activeFile={activeFile} />
    </div>

    <div
      id="vim-cmdline"
      hidden
      class="fixed left-0 right-0 z-30 bg-bg-dark border-t border-border px-3 py-1 font-mono text-sm"
      style="bottom: 28px;"
    >
      <span class="text-red font-bold mr-3 text-xs">COMMAND</span>
      <span class="text-yellow">:</span><span id="vim-cmdline-input" class="text-fg"></span><span class="terminal-cursor text-fg">▌</span>
      <span class="ml-4 text-comment text-[10px]">enter to run · esc to cancel · :help</span>
    </div>

    <div
      id="vim-toast"
      class="fixed left-0 right-0 z-30 bg-bg-dark border-t border-border px-3 py-1 font-mono text-xs"
      style="bottom: 28px; display: none; transition: opacity 280ms ease-out;"
    >
      <span id="vim-toast-text" class="text-red"></span>
    </div>

    <TelescopeModal />

    <script>
      // ============ Vim-style navigation on internal pages ============
      // Two focused "windows": the buffer (content) and the tree (sidebar).
      //   - On load the buffer is focused; j/k/h/l moves the cursor through
      //     block-level elements of the rendered page.
      //   - Typing `:ex` (or `:tree`) moves focus to the file tree.
      //   - `:buf` or Esc returns focus to the buffer.
      //   - Opening a file resets focus to buffer on the next page load.
      // Leader (SPC chords) keep working — handled at capture phase in
      // StatusBar.astro and they stand down while command mode is open.

      const main      = document.querySelector<HTMLElement>("main");
      const article   = main?.querySelector<HTMLElement>("article") ?? null;
      const treeItems = Array.from(document.querySelectorAll<HTMLAnchorElement>("aside .tree-row"));
      const aside     = document.querySelector<HTMLElement>("aside");
      const cmdLineEl   = document.getElementById("vim-cmdline");
      const cmdInputEl  = document.getElementById("vim-cmdline-input");
      const toastEl     = document.getElementById("vim-toast");
      const toastTextEl = document.getElementById("vim-toast-text");

      const blockSelector = "h1, h2, h3, p, li, pre, .grid > a";
      const blocks: HTMLElement[] = article
        ? Array.from(article.querySelectorAll<HTMLElement>(blockSelector))
        : [];

      type Focus = "buffer" | "tree";
      type Mode  = "NORMAL" | "COMMAND";

      let focus: Focus = "buffer";
      let mode: Mode = "NORMAL";
      let bufIdx = 0;
      let treeIdx = (() => {
        const i = treeItems.findIndex((el) => el.getAttribute("href") === location.pathname);
        return i >= 0 ? i : 0;
      })();

      let cmdBuffer = "";
      let countBuffer = "";
      let gPending = false;
      let gTimer: ReturnType<typeof setTimeout> | null = null;

      function setFocus(t: Focus) {
        focus = t;
        document.documentElement.classList.toggle("buffer-focus", t === "buffer");
        document.documentElement.classList.toggle("tree-focus", t === "tree");
      }

      function applyBufCursor() {
        blocks.forEach((el, i) => el.classList.toggle("buf-cursor", i === bufIdx));
        blocks[bufIdx]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }

      function applyTreeSelection() {
        treeItems.forEach((el, i) => el.classList.toggle("is-selected", i === treeIdx));
        if (focus === "tree") treeItems[treeIdx]?.scrollIntoView({ block: "nearest" });
      }

      function moveBuf(delta: number) {
        if (blocks.length === 0) return;
        bufIdx = Math.max(0, Math.min(blocks.length - 1, bufIdx + delta));
        applyBufCursor();
      }

      function moveTree(delta: number) {
        if (treeItems.length === 0) return;
        treeIdx = (treeIdx + delta + treeItems.length) % treeItems.length;
        applyTreeSelection();
      }

      function move(delta: number) {
        if (focus === "tree") moveTree(delta);
        else moveBuf(delta);
      }

      function jumpFirst() {
        if (focus === "tree") { treeIdx = 0; applyTreeSelection(); }
        else                  { bufIdx = 0; applyBufCursor(); }
      }
      function jumpLast() {
        if (focus === "tree") { treeIdx = treeItems.length - 1; applyTreeSelection(); }
        else                  { bufIdx = blocks.length - 1; applyBufCursor(); }
      }

      function activate() {
        if (focus === "tree") {
          treeItems[treeIdx]?.click();
          return;
        }
        const block = blocks[bufIdx];
        if (!block) return;
        const link = block.tagName === "A"
          ? (block as HTMLAnchorElement)
          : block.querySelector<HTMLAnchorElement>("a[href]");
        link?.click();
      }

      function consumeCount() {
        const n = parseInt(countBuffer) || 1;
        countBuffer = "";
        return Math.min(n, 99);
      }

      function clearG() {
        gPending = false;
        if (gTimer) { clearTimeout(gTimer); gTimer = null; }
      }

      // -------- Transient toast (vim-style status message) --------
      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      let toastHideTimer: ReturnType<typeof setTimeout> | null = null;

      function showToast(msg: string, type: "error" | "info" = "error") {
        if (!toastEl || !toastTextEl) return;
        toastTextEl.textContent = msg;
        toastTextEl.className = type === "error" ? "text-red" : "text-yellow";
        toastEl.style.display = "block";
        toastEl.style.opacity = "1";
        if (toastTimer) clearTimeout(toastTimer);
        if (toastHideTimer) clearTimeout(toastHideTimer);
        toastTimer = setTimeout(() => {
          toastEl.style.opacity = "0";
          toastHideTimer = setTimeout(() => {
            if (toastEl.style.opacity === "0") toastEl.style.display = "none";
          }, 320);
        }, 2500);
      }

      // -------- Line numbers (`:set number` / `:set nonumber`) --------
      const LINE_NUM_KEY = "vim-line-numbers";

      function removeLineNumbers() {
        document.getElementById("vim-gutter")?.remove();
        // Clean up any leftovers from the previous inline implementation
        document.querySelectorAll(".line-num").forEach((el) => el.remove());
      }

      function applyLineNumbers() {
        removeLineNumbers();
        if (!main) return;
        main.style.position = "relative";

        const gutter = document.createElement("div");
        gutter.id = "vim-gutter";
        gutter.style.cssText =
          "position:absolute; left:1rem; top:0; width:2rem; " +
          "pointer-events:none; user-select:none; z-index:5;";
        main.appendChild(gutter);

        const mainRect = main.getBoundingClientRect();
        let counter = 1;
        blocks.forEach((block) => {
          if (block.matches(".grid > a")) return; // cards live in a CSS grid, skip
          const blockRect = block.getBoundingClientRect();
          const top = blockRect.top - mainRect.top + main.scrollTop;

          const num = document.createElement("div");
          num.className = "vim-gutter-num";
          num.style.top = `${top}px`;
          num.textContent = String(counter++);
          gutter.appendChild(num);
        });
      }

      // Recompute on resize — the centered article shifts when main's width changes.
      window.addEventListener("resize", () => {
        if (document.documentElement.classList.contains("show-line-numbers")) {
          applyLineNumbers();
        }
      });

      function setLineNumbers(on: boolean) {
        document.documentElement.classList.toggle("show-line-numbers", on);
        if (on) applyLineNumbers();
        else removeLineNumbers();
        try { localStorage.setItem(LINE_NUM_KEY, on ? "1" : "0"); } catch {}
      }

      // Restore preference on load
      try {
        if (localStorage.getItem(LINE_NUM_KEY) === "1") setLineNumbers(true);
      } catch (_) {}

      function isTyping(t: EventTarget | null) {
        if (!(t instanceof HTMLElement)) return false;
        return ["INPUT","TEXTAREA","SELECT"].includes(t.tagName) || t.isContentEditable;
      }

      // -------- Command mode --------
      function enterCmdMode() {
        mode = "COMMAND";
        cmdBuffer = "";
        if (cmdInputEl) cmdInputEl.textContent = "";
        if (cmdLineEl) cmdLineEl.hidden = false;
        (window as any).__vimCmdMode = true;
      }

      function exitCmdMode() {
        mode = "NORMAL";
        cmdBuffer = "";
        if (cmdLineEl) cmdLineEl.hidden = true;
        (window as any).__vimCmdMode = false;
      }

      const fileAliases: Record<string, string> = {
        "readme":           "/readme",
        "readme.md":        "/readme",
        "about":            "/readme",
        "research":         "/research",
        "research.bib":     "/research",
        "publications":     "/research",
        "publications.bib": "/research",
        "pubs":             "/research",
        "preprints":        "/research",
        "projects":         "/projects",
        "projects.md":      "/projects",
        "blogs":            "/blogs",
        "blogs.md":         "/blogs",
        "blog":             "/blogs",
        "notes":            "/blogs",
        "help":             "/help",
        "help.txt":         "/help",
      };

      function nav(url: string, opts?: { download?: boolean; external?: boolean }) {
        const fn = (window as any).__navigateTo;
        if (typeof fn === "function") { fn(url, opts); return; }
        if (opts?.external) { window.open(url, "_blank", "noopener,noreferrer"); return; }
        location.href = url;
      }

      const exCommands: Record<string, () => void> = {
        "q":         () => nav("/"),
        "quit":      () => nav("/"),
        "home":      () => nav("/"),
        "dashboard": () => nav("/"),
        "alpha":     () => nav("/"),
        "ex":        () => setFocus("tree"),
        "tree":      () => setFocus("tree"),
        "nvimtree":  () => setFocus("tree"),
        "buf":       () => setFocus("buffer"),
        "buffer":    () => setFocus("buffer"),
        "cv":        () => nav("/cv/cv.pdf", { download: true }),
        "gh":        () => nav("https://github.com/peterwisu", { external: true }),
        "github":    () => nav("https://github.com/peterwisu", { external: true }),
        "help":      () => nav("/help"),
        "h":         () => nav("/help"),
        "telescope": () => window.dispatchEvent(new CustomEvent("vim:telescope-open")),
        "tel":       () => window.dispatchEvent(new CustomEvent("vim:telescope-open")),
        "ff":        () => window.dispatchEvent(new CustomEvent("vim:telescope-open")),
      };

      function executeCmd(raw: string) {
        const cmd = raw.trim().toLowerCase();
        if (!cmd) return;
        if (cmd in exCommands) { exCommands[cmd](); return; }

        // :set number / :set nu / :set nonumber / :set nonu
        const setMatch = cmd.match(/^set\s+(.+)$/);
        if (setMatch) {
          const arg = setMatch[1].trim();
          if (arg === "number" || arg === "nu")        { setLineNumbers(true);  showToast("line numbers on", "info"); return; }
          if (arg === "nonumber" || arg === "nonu")    { setLineNumbers(false); showToast("line numbers off", "info"); return; }
          showToast(`E518: Unknown option: ${arg}`);
          return;
        }

        // :e <name> / :edit <name>
        const editMatch = cmd.match(/^(e|edit)\s+(.+)$/);
        if (editMatch) {
          const target = editMatch[2].trim();
          if (target in fileAliases) { nav(fileAliases[target]); return; }
          showToast(`E447: Can't find file "${target}" in path`);
          return;
        }

        if (cmd in fileAliases) { nav(fileAliases[cmd]); return; }
        showToast(`E492: Not an editor command: ${raw.trim()}`);
      }

      // Keys that would normally enter insert / edit mode in vim
      const INSERT_KEYS = new Set(["i", "I", "a", "A", "o", "O", "s", "S", "R"]);

      // -------- Single keydown handler --------
      document.addEventListener("keydown", (e) => {
        if (e.metaKey || e.altKey) return;
        if (isTyping(e.target)) return;

        if (mode === "COMMAND") {
          e.preventDefault();
          e.stopImmediatePropagation();
          if (e.key === "Escape")    { exitCmdMode(); return; }
          if (e.key === "Enter")     { const c = cmdBuffer; exitCmdMode(); executeCmd(c); return; }
          if (e.key === "Backspace") {
            cmdBuffer = cmdBuffer.slice(0, -1);
            if (cmdInputEl) cmdInputEl.textContent = cmdBuffer;
            return;
          }
          if (e.key.length === 1) {
            cmdBuffer += e.key;
            if (cmdInputEl) cmdInputEl.textContent = cmdBuffer;
          }
          return;
        }

        if (e.defaultPrevented) return; // leader claimed it

        if (e.key === ":") {
          e.preventDefault();
          enterCmdMode();
          return;
        }

        // Read-only buffer — refuse any INSERT-mode entry
        if (INSERT_KEYS.has(e.key) && !e.ctrlKey) {
          e.preventDefault();
          showToast("E382: 'modifiable' is off — this buffer is read-only");
          clearG(); countBuffer = "";
          return;
        }

        if (/^\d$/.test(e.key)) {
          if (e.key !== "0" || countBuffer.length > 0) {
            e.preventDefault();
            countBuffer += e.key;
            return;
          }
        }

        if (e.ctrlKey) {
          if (e.key === "d" || e.key === "D") {
            e.preventDefault();
            main?.scrollBy({ top: main.clientHeight / 2, behavior: "smooth" });
          } else if (e.key === "u" || e.key === "U") {
            e.preventDefault();
            main?.scrollBy({ top: -main.clientHeight / 2, behavior: "smooth" });
          }
          return;
        }

        switch (e.key) {
          case "j":
          case "ArrowDown": {
            e.preventDefault();
            const n = consumeCount();
            for (let i = 0; i < n; i++) move(1);
            clearG();
            break;
          }
          case "k":
          case "ArrowUp": {
            e.preventDefault();
            const n = consumeCount();
            for (let i = 0; i < n; i++) move(-1);
            clearG();
            break;
          }
          case "h":
          case "ArrowLeft":
            // In tree focus, h goes back to buffer (like vim's window-left).
            // In buffer focus, h is a no-op (we don't model character cursor).
            e.preventDefault();
            if (focus === "tree") setFocus("buffer");
            clearG(); countBuffer = "";
            break;
          case "Enter":
          case "l":
          case "ArrowRight":
            e.preventDefault();
            activate();
            clearG(); countBuffer = "";
            break;
          case "g":
            e.preventDefault();
            if (gPending) { jumpFirst(); clearG(); }
            else { gPending = true; gTimer = setTimeout(clearG, 800); }
            countBuffer = "";
            break;
          case "G":
          case "e":
            e.preventDefault();
            jumpLast();
            clearG(); countBuffer = "";
            break;
          case "b":
            e.preventDefault();
            jumpFirst();
            clearG(); countBuffer = "";
            break;
          case "q":
            e.preventDefault();
            nav("/");
            break;
          case "Escape":
            if (focus === "tree") setFocus("buffer");
            clearG(); countBuffer = "";
            break;
          default:
            if (e.key.length === 1) { countBuffer = ""; clearG(); }
        }
      });

      // Mouse: hovering tree items only previews when tree is focused.
      treeItems.forEach((el, i) => {
        el.addEventListener("mouseenter", () => {
          if (focus !== "tree") return;
          treeIdx = i;
          applyTreeSelection();
        });
      });

      // Click-to-focus
      main?.addEventListener("click", () => setFocus("buffer"));
      aside?.addEventListener("click", () => setFocus("tree"));

      // Initial render
      applyBufCursor();
      applyTreeSelection();
    </script>
  </body>
</html>
