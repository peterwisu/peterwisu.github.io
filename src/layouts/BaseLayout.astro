---
import "../styles/global.css";
import { getEntry } from "astro:content";

interface Props {
  title?: string;
}

const { title } = Astro.props;

const aboutEntry = await getEntry("about", "index");
const about = aboutEntry?.data;
const name = about?.name ?? "Wish (Peter) Suharitdamrong";
const role = about?.title;
const cv = about?.cv;
const social = about?.social ?? [];

const pageTitle = title ? `${name.split(" ")[0]} | ${title}` : name;

const nav = [
  { label: "About", href: "/about" },
  { label: "Research", href: "/research" },
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "/blogs" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");

const SOCIAL_LABEL: Record<string, string> = {
  github: "GitHub",
  x: "X",
  twitter: "X",
  linkedin: "LinkedIn",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>
      // Default light; switch to dark only when explicitly stored.
      try {
        if (localStorage.getItem("theme") === "dark")
          document.documentElement.classList.add("dark");
      } catch (_) {}
    </script>
  </head>
  <body class="bg-bg text-fg">
    <div class="md:flex md:min-h-screen">
      <!-- Sidebar -->
      <aside
        class="md:fixed md:top-0 md:left-0 md:h-screen md:w-[240px] md:flex md:flex-col px-6 py-8 md:py-10"
      >
        <div class="md:flex-1">
          <a href="/" class="block no-underline">
            <div class="text-sm font-semibold tracking-tight text-fg leading-tight" style="text-transform: uppercase; letter-spacing: 0.04em;">
              {name}
            </div>
            {role && (
              <div class="text-xs text-comment mt-1" style="letter-spacing: 0.06em;">{role}</div>
            )}
          </a>

          <nav class="mt-7 flex md:block gap-5 flex-wrap">
            {nav.map((item) => (
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        <!-- Sidebar footer: meta links + theme toggle -->
        <div class="mt-7 md:mt-0 flex flex-wrap items-center gap-x-4 gap-y-2">
          {cv && <a href="/cv" class="meta-link">CV</a>}
          {social.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="meta-link">
              {SOCIAL_LABEL[s.platform] ?? s.platform}
            </a>
          ))}
          <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Toggle dark mode">
            <span data-theme-label>Dark</span>
          </button>
        </div>
      </aside>

      <!-- Content -->
      <main class="flex-1 md:ml-[240px] px-6 py-10 md:px-16 md:py-16">
        <slot />
      </main>
    </div>

    <script>
      const btn = document.getElementById("theme-toggle");
      const label = btn?.querySelector("[data-theme-label]");
      const sync = () => {
        const dark = document.documentElement.classList.contains("dark");
        if (label) label.textContent = dark ? "Light" : "Dark";
      };
      sync();
      btn?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (_) {}
        sync();
      });
    </script>
  </body>
</html>
