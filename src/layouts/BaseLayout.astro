---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getEntry } from "astro:content";

interface Props {
  title?: string;
}

const { title } = Astro.props;

const aboutEntry = await getEntry("about", "index");
const about = aboutEntry?.data;
const name = about?.name ?? "Wish (Peter) Suharitdamrong";
const role = about?.title;

const pageTitle = title ? `${name.split(" ")[0]} | ${title}` : name;

const nav = [
  { label: "About", href: "/about" },
  { label: "Research", href: "/research" },
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "/blogs" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
      // Default light; switch to dark only when explicitly stored.
      try {
        if (localStorage.getItem("theme") === "dark")
          document.documentElement.classList.add("dark");
      } catch (_) {}
    </script>
  </head>
  <body class="bg-bg text-fg">
    <div class="shell">
      <!-- Sidebar -->
      <aside class="shell-sidebar">
        <div class="md:flex-1">
          <a href="/" class="block no-underline">
            <div class="text-sm font-semibold tracking-tight text-fg leading-tight" style="text-transform: uppercase; letter-spacing: 0.04em;">
              {name}
            </div>
            {role && (
              <div class="text-xs text-comment mt-1" style="letter-spacing: 0.06em;">{role}</div>
            )}
          </a>

          <nav class="mt-7 flex md:block gap-5 flex-wrap">
            {nav.map((item) => (
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        <!-- Sidebar footer: theme toggle -->
        <div class="mt-7 md:mt-0">
          <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Toggle dark or light mode">
            <span data-theme-icon aria-hidden="true">☾</span>
            <span data-theme-label>Dark mode</span>
          </button>
        </div>
      </aside>

      <!-- Content -->
      <main class="shell-content">
        <slot />
      </main>
    </div>

    <script>
      // Rebind on every page load — `astro:page-load` fires on first load and
      // after each View Transition navigation (when the body is swapped).
      function initThemeToggle() {
        const btn = document.getElementById("theme-toggle");
        const label = btn?.querySelector("[data-theme-label]");
        const icon = btn?.querySelector("[data-theme-icon]");
        const sync = () => {
          const dark = document.documentElement.classList.contains("dark");
          // Show the mode you'll switch *to*, so the action is clear.
          if (label) label.textContent = dark ? "Light mode" : "Dark mode";
          if (icon) icon.textContent = dark ? "☀" : "☾";
        };
        sync();
        btn?.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (_) {}
          sync();
        });
      }
      document.addEventListener("astro:page-load", initThemeToggle);
    </script>
  </body>
</html>
