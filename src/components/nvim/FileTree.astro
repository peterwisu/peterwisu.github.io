---
import { SITE_CONFIG } from "../../config";

interface Props {
  activeFile: string;
}

const { activeFile } = Astro.props;

interface Entry {
  name: string;
  path?: string;
  type: "file" | "folder";
  ext?: string;
  children?: Entry[];
}

const tree: Entry[] = [
  { name: "README.md", path: "/readme", type: "file", ext: "md" },
  { name: "research.bib", path: "/research", type: "file", ext: "bib" },
  { name: "projects.md", path: "/projects", type: "file", ext: "md" },
  {
    name: "blogs",
    type: "folder",
    children: [
      { name: "hello-world.md", path: "/blogs", type: "file", ext: "md" },
    ],
  },
  ...(SITE_CONFIG.showGames
    ? [{
        name: "games",
        type: "folder" as const,
        children: [
          { name: "tetris.js",    path: "/games/tetris",    type: "file" as const, ext: "js" },
          { name: "snake.js",     path: "/games/snake",     type: "file" as const, ext: "js" },
          { name: "blackjack.js", path: "/games/blackjack", type: "file" as const, ext: "js" },
        ],
      }]
    : []),
  { name: "help.txt", path: "/help", type: "file", ext: "txt" },
];

interface DevIcon {
  icon: string;
  color: string;
}

const devicons: Record<string, DevIcon> = {
  md:  { icon: "M",   color: "text-blue" },
  bib: { icon: "B",   color: "text-yellow" },
  py:  { icon: "py",  color: "text-green" },
  tex: { icon: "tex", color: "text-cyan" },
  txt: { icon: "?",   color: "text-purple" },
  js:  { icon: "js",  color: "text-yellow" },
};

const fallback: DevIcon = { icon: "?", color: "text-fg-dark" };

function countFiles(entries: Entry[]): number {
  let n = 0;
  for (const e of entries) {
    if (e.type === "file") n++;
    if (e.children) n += countFiles(e.children);
  }
  return n;
}

const fileCount = countFiles(tree);
---

<div class="px-3 py-3 text-sm">
  <div class="text-comment text-[10px] uppercase tracking-wider mb-1">NvimTree</div>
  <a
    href="/"
    class="block text-fg-dark text-xs mb-2 truncate hover:text-blue transition"
    title="Go to dashboard"
  >
    ~/wish-suharitdamrong
  </a>
  <div class="border-b border-border mb-2"></div>

  <a
    href="/"
    class="tree-row flex items-center gap-2 rounded px-1 -mx-1 hover:bg-bg-highlight mb-2"
    title="Back to home (SPC d)"
    data-name="home"
  >
    <span class="text-purple text-[10px] w-6 text-center font-bold">α</span>
    <span class="text-fg-dark">home</span>
    <span class="ml-auto text-comment text-[10px]">SPC d</span>
  </a>

  <ul class="space-y-0.5">
    {tree.map((entry) => {
      if (entry.type === "folder") {
        const hasActive = entry.children?.some((c) => c.path === activeFile);
        return (
          <li>
            <details open={hasActive || (entry.children && entry.children.length > 0)}>
              <summary class="cursor-pointer list-none flex items-center gap-1.5 rounded px-1 -mx-1 hover:bg-bg-highlight">
                <span class="text-comment text-[10px] w-3 inline-block">▾</span>
                <span class="text-yellow">▸</span>
                <span class="text-fg-dark">{entry.name}</span>
              </summary>
              <ul class="ml-3 mt-0.5 space-y-0.5 tree-guide pl-3">
                {entry.children?.map((child) => {
                  const di = devicons[child.ext ?? ""] ?? fallback;
                  const isActive = child.path === activeFile;
                  return (
                    <li>
                      <a
                        href={child.path}
                        data-name={child.name}
                        class={`tree-row flex items-center gap-2 rounded px-1 -mx-1 hover:bg-bg-highlight ${isActive ? "bg-bg-highlight border-l-2 border-blue pl-2 -ml-2" : ""}`}
                      >
                        <span class={`${di.color} text-[10px] w-6 text-center font-bold`}>{di.icon}</span>
                        <span class={isActive ? "text-fg font-medium" : "text-fg-dark"}>{child.name}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </details>
          </li>
        );
      }

      const di = devicons[entry.ext ?? ""] ?? fallback;
      const isActive = entry.path === activeFile;
      return (
        <li>
          <a
            href={entry.path}
            data-name={entry.name}
            class={`tree-row flex items-center gap-2 rounded px-1 -mx-1 hover:bg-bg-highlight ${isActive ? "bg-bg-highlight border-l-2 border-blue pl-2 -ml-2" : ""}`}
          >
            <span class={`${di.color} text-[10px] w-6 text-center font-bold`}>{di.icon}</span>
            <span class={isActive ? "text-fg font-medium" : "text-fg-dark"}>{entry.name}</span>
          </a>
        </li>
      );
    })}
  </ul>

  <div class="border-t border-border mt-4 pt-2 text-comment text-[11px]">
    {fileCount} files
  </div>
</div>
