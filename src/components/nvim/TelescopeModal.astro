---
// Telescope-style fuzzy file picker. Triggered by SPC ff or :Telescope / :tel.
// Listens for a custom "vim:telescope-open" event so any handler can open it.
---

<div
  id="telescope-modal"
  hidden
  class="fixed inset-0 z-40 flex items-start justify-center pt-24"
  role="dialog"
  aria-modal="true"
  aria-label="Find files"
>
  <div id="telescope-bg" class="absolute inset-0 bg-black/45"></div>
  <div class="telescope-panel relative w-[520px] max-w-[90vw] bg-bg-dark border border-border rounded shadow-2xl">
    <div class="flex items-center px-3 py-2 border-b border-border">
      <span class="text-blue mr-2 font-bold">▷</span>
      <input
        id="telescope-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="Find Files…"
        class="flex-1 bg-transparent outline-none text-fg font-mono text-sm placeholder:text-comment"
      />
      <span class="text-comment text-[10px] font-mono ml-2"><span id="telescope-count">0 / 0</span></span>
    </div>
    <ul id="telescope-results" class="max-h-80 overflow-y-auto py-1 font-mono"></ul>
    <div class="px-3 py-1.5 border-t border-border text-comment text-[10px] flex gap-4">
      <span><span class="text-yellow">↑↓</span> / <span class="text-yellow">^n ^p</span> navigate</span>
      <span><span class="text-yellow">enter</span> open</span>
      <span><span class="text-yellow">esc</span> close</span>
    </div>
  </div>
</div>

<script>
  import { SITE_CONFIG } from "../../config";

  interface Item { name: string; path: string; subtitle?: string; }

  const items: Item[] = [
    { name: "α home (dashboard)", path: "/" },
    { name: "README.md",          path: "/readme",   subtitle: "About me, contact" },
    { name: "research.bib",       path: "/research", subtitle: "Preprints and publications" },
    ...(SITE_CONFIG.showProjects
      ? [{ name: "projects.md", path: "/projects", subtitle: "Research code and experiments" }]
      : []),
    ...(SITE_CONFIG.showBlog
      ? [{ name: "blogs/", path: "/blogs", subtitle: "Short-form writing and notes" }]
      : []),
    { name: "cv.pdf",             path: "/cv",       subtitle: "Embedded CV preview" },
    { name: "help.txt",           path: "/help",     subtitle: "Keybinding reference" },
  ];

  const modal     = document.getElementById("telescope-modal");
  const input     = document.getElementById("telescope-input") as HTMLInputElement | null;
  const resultsEl = document.getElementById("telescope-results");
  const bgEl      = document.getElementById("telescope-bg");
  const countEl   = document.getElementById("telescope-count");

  let filtered: Item[] = items.slice();
  let selectedIdx = 0;

  function fuzzyScore(query: string, target: string): number {
    if (!query) return 1;
    const q = query.toLowerCase();
    const t = target.toLowerCase();
    let qi = 0, lastMatch = -1, score = 0;
    for (let i = 0; i < t.length && qi < q.length; i++) {
      if (t[i] === q[qi]) {
        score += 10;
        if (lastMatch >= 0 && i - lastMatch === 1) score += 6;
        if (i === 0 || /[\s\/\-_.]/.test(t[i - 1])) score += 4;
        lastMatch = i;
        qi++;
      }
    }
    return qi === q.length ? score : 0;
  }

  function refilter() {
    const q = (input?.value ?? "").trim();
    filtered = items
      .map((i) => ({ item: i, score: fuzzyScore(q, i.name + " " + (i.subtitle ?? "")) }))
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score)
      .map((x) => x.item);
    selectedIdx = 0;
    render();
  }

  function render() {
    if (!resultsEl) return;
    resultsEl.innerHTML = "";
    if (countEl) countEl.textContent = `${Math.min(filtered.length, items.length)} / ${items.length}`;

    if (filtered.length === 0) {
      const li = document.createElement("li");
      li.className = "telescope-row text-comment italic";
      li.textContent = "  No matches";
      resultsEl.appendChild(li);
      return;
    }

    filtered.forEach((item, i) => {
      const li = document.createElement("li");
      li.className = "telescope-row";
      if (i === selectedIdx) li.classList.add("is-selected");
      li.innerHTML =
        '<span class="text-blue mr-2">' + (i === selectedIdx ? "▸" : " ") + '</span>' +
        '<span class="text-fg">' + escapeHtml(item.name) + '</span>' +
        (item.subtitle ? '<span class="text-comment text-xs ml-3">' + escapeHtml(item.subtitle) + '</span>' : '') +
        '<span class="text-comment text-[10px] ml-auto">' + escapeHtml(item.path) + '</span>';
      li.addEventListener("click", () => activate(i));
      li.addEventListener("mouseenter", () => { selectedIdx = i; render(); });
      resultsEl.appendChild(li);
    });
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"})[c] as string);
  }

  function move(delta: number) {
    if (filtered.length === 0) return;
    selectedIdx = (selectedIdx + delta + filtered.length) % filtered.length;
    render();
    resultsEl?.querySelector(".is-selected")?.scrollIntoView({ block: "nearest" });
  }

  function activate(idx?: number) {
    const target = filtered[idx ?? selectedIdx];
    if (!target) return;
    close();
    const fn = (window as any).__navigateTo;
    if (typeof fn === "function") fn(target.path);
    else location.href = target.path;
  }

  function open() {
    if (!modal) return;
    modal.hidden = false;
    if (input) { input.value = ""; }
    refilter();
    setTimeout(() => input?.focus(), 50);
    (window as any).__telescopeOpen = true;
  }

  function close() {
    if (!modal) return;
    modal.hidden = true;
    (window as any).__telescopeOpen = false;
  }

  bgEl?.addEventListener("click", close);

  input?.addEventListener("keydown", (e) => {
    if (e.key === "Escape" || (e.ctrlKey && (e.key === "c" || e.key === "[" ))) {
      e.preventDefault();
      close();
      return;
    }
    if (e.key === "ArrowDown" || (e.ctrlKey && (e.key === "n" || e.key === "j"))) {
      e.preventDefault();
      move(1);
      return;
    }
    if (e.key === "ArrowUp" || (e.ctrlKey && (e.key === "p" || e.key === "k"))) {
      e.preventDefault();
      move(-1);
      return;
    }
    if (e.key === "Enter") {
      e.preventDefault();
      activate();
      return;
    }
  });

  input?.addEventListener("input", refilter);

  window.addEventListener("vim:telescope-open", open);
</script>

<style>
  .telescope-row {
    display: flex;
    align-items: center;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    font-size: 0.85rem;
    user-select: none;
  }
  .telescope-row.is-selected {
    background-color: var(--tn-bg-highlight);
    box-shadow: inset 2px 0 0 var(--tn-blue);
  }
  .telescope-panel {
    font-variant-numeric: tabular-nums;
  }
</style>
