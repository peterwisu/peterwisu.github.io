---
interface Props {
  mode?: string;
  fileType?: string;
  activeFile?: string;
}

const { mode = "NORMAL", fileType = "markdown", activeFile = "home.md" } = Astro.props;

const modeStyles: Record<string, { bg: string; arrow: string }> = {
  NORMAL:  { bg: "bg-blue",   arrow: "text-blue" },
  INSERT:  { bg: "bg-green",  arrow: "text-green" },
  VISUAL:  { bg: "bg-purple", arrow: "text-purple" },
  COMMAND: { bg: "bg-red",    arrow: "text-red" },
};

const m = modeStyles[mode] ?? modeStyles.NORMAL;

const fileName = activeFile.startsWith("/") ? activeFile.replace(/^\//, "") + ".md" : activeFile;
---

<footer class="flex items-stretch h-7 text-xs select-none bg-bg-dark">
  <div class={`${m.bg} text-bg font-bold px-3 flex items-center`}>
    <span class="tracking-wider">{mode}</span>
  </div>
  <span class={`${m.arrow} bg-bg-highlight flex items-center pl-0.5`}>▶</span>

  <div class="bg-bg-highlight text-fg-dark px-3 flex items-center gap-1.5">
    <span class="text-purple">⎇</span>
    <span>main</span>
  </div>
  <span class="text-bg-highlight bg-bg-dark flex items-center pl-0.5">▶</span>

  <div class="bg-bg-dark text-fg-dark px-3 flex items-center gap-1.5">
    <span class="text-blue">M</span>
    <span>{fileName}</span>
  </div>
  <span class="text-bg-dark bg-bg flex items-center pl-0.5">▶</span>

  <div class="bg-bg text-comment px-3 flex items-center gap-3">
    <span class="flex items-center gap-1"><span class="text-red">●</span><span data-diag="errors">0</span></span>
    <span class="flex items-center gap-1"><span class="text-yellow">▲</span><span data-diag="warnings">0</span></span>
  </div>

  <div class="flex-1 bg-bg"></div>

  <span class="text-bg-dark bg-bg flex items-center pr-0.5">◀</span>
  <div class="bg-bg-dark text-fg-dark px-3 flex items-center">{fileType}</div>

  <span class="text-bg-highlight bg-bg-dark flex items-center pr-0.5">◀</span>
  <div class="bg-bg-highlight text-fg-dark px-3 flex items-center">utf-8[unix]</div>

  <span class={`${m.arrow} bg-bg-highlight flex items-center pr-0.5`}>◀</span>
  <div class={`${m.bg} text-bg font-bold px-3 flex items-center`}>3:1</div>

  <div class={`${m.bg} text-bg font-bold px-3 flex items-center border-l border-bg/30`}>12%</div>

  <div class="relative flex">
    <button
      id="theme-toggle"
      type="button"
      aria-label="Choose theme (SPC u h)"
      aria-haspopup="menu"
      aria-expanded="false"
      title="Choose theme (SPC u h)"
      class="bg-bg-dark px-3 flex items-center hover:bg-bg-highlight cursor-pointer"
    ><span id="theme-toggle-icon">◐</span></button>
    <div
      id="theme-picker"
      class="theme-picker absolute bottom-full right-0 mb-1 z-50"
      role="menu"
      aria-hidden="true"
    >
      <div class="theme-picker-panel">
        <div class="px-3 pt-1.5 pb-1 text-comment text-[10px] uppercase tracking-wider">Theme</div>
        <button class="picker-item" role="menuitemradio" data-set-theme="claude">
          <span class="picker-swatch" style="background:#ea8a3d;color:#ea8a3d"></span>
          <span>Claude</span>
          <span class="ml-auto text-comment text-[10px]">retro</span>
        </button>
        <button class="picker-item" role="menuitemradio" data-set-theme="storm">
          <span class="picker-swatch" style="background:#7aa2f7;color:#7aa2f7"></span>
          <span>Storm</span>
          <span class="ml-auto text-comment text-[10px]">dark</span>
        </button>
        <button class="picker-item" role="menuitemradio" data-set-theme="light">
          <span class="picker-swatch" style="background:#2e7de9;color:#2e7de9"></span>
          <span>Day</span>
          <span class="ml-auto text-comment text-[10px]">light</span>
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  // ---- Theme picker ----
  // Claude (warm retro) is the default — :root has its palette. Storm and Day
  // are activated by adding ".storm" or ".light" to the html element.
  const html = document.documentElement;
  const btn = document.getElementById("theme-toggle");
  const iconEl = document.getElementById("theme-toggle-icon");
  const picker = document.getElementById("theme-picker");

  type ThemeName = "claude" | "storm" | "light";
  const ICONS: Record<ThemeName, string> = { claude: "◐", storm: "☾", light: "☀" };
  const COLORS: Record<ThemeName, string> = {
    claude: "#ea8a3d",
    storm:  "#7aa2f7",
    light:  "#2e7de9",
  };

  function currentTheme(): ThemeName {
    if (html.classList.contains("light")) return "light";
    if (html.classList.contains("storm")) return "storm";
    return "claude";
  }

  function applyTheme(t: ThemeName) {
    html.classList.remove("light", "storm");
    if (t === "light") html.classList.add("light");
    else if (t === "storm") html.classList.add("storm");
    try { localStorage.setItem("theme", t); } catch {}
    syncIcon();
    syncPickerSelection();
  }

  function syncIcon() {
    if (!iconEl) return;
    const t = currentTheme();
    iconEl.textContent = ICONS[t];
    iconEl.style.color = COLORS[t];
    iconEl.style.textShadow = `0 0 8px ${COLORS[t]}`;
  }

  function syncPickerSelection() {
    const t = currentTheme();
    document.querySelectorAll<HTMLElement>("[data-set-theme]").forEach((el) => {
      el.setAttribute("aria-current", el.getAttribute("data-set-theme") === t ? "true" : "false");
    });
  }

  function openPicker() {
    if (!picker) return;
    picker.classList.add("open");
    picker.setAttribute("aria-hidden", "false");
    btn?.setAttribute("aria-expanded", "true");
  }

  function closePicker() {
    if (!picker) return;
    picker.classList.remove("open");
    picker.setAttribute("aria-hidden", "true");
    btn?.setAttribute("aria-expanded", "false");
  }

  function togglePicker() {
    if (!picker) return;
    if (picker.classList.contains("open")) closePicker();
    else openPicker();
  }

  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    togglePicker();
  });

  document.querySelectorAll<HTMLElement>("[data-set-theme]").forEach((el) => {
    el.addEventListener("click", () => {
      const t = el.getAttribute("data-set-theme") as ThemeName | null;
      if (t) applyTheme(t);
      closePicker();
    });
  });

  document.addEventListener("click", (e) => {
    if (!picker?.classList.contains("open")) return;
    if (picker.contains(e.target as Node) || btn?.contains(e.target as Node)) return;
    closePicker();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && picker?.classList.contains("open")) {
      e.preventDefault();
      closePicker();
    }
  });

  syncIcon();
  syncPickerSelection();

  // ---- Ambient diagnostics ticker (dashboard only) ----
  if (location.pathname === "/" || location.pathname === "/index.html") {
    const errEl  = document.querySelector<HTMLElement>('[data-diag="errors"]');
    const warnEl = document.querySelector<HTMLElement>('[data-diag="warnings"]');

    function bump(el: HTMLElement | null, max: number) {
      if (!el) return;
      if (Math.random() < 0.35) {
        const next = Math.floor(Math.random() * (max + 1));
        el.textContent = String(next);
      } else {
        el.textContent = "0";
      }
    }

    setInterval(() => {
      bump(errEl, 1);
      bump(warnEl, 2);
    }, 2800);
  }

  // ---- Leader (SPC) keybindings ----
  // Basic Stage-1 implementation: a single global handler matches a small set
  // of leader chords. Full NORMAL/INSERT/VISUAL mode handling comes in Stage 4.
  type Action = () => void;
  function navFallback(url: string, opts?: { download?: boolean; external?: boolean }) {
    const fn = (window as any).__navigateTo;
    if (typeof fn === "function") { fn(url, opts); return; }
    if (opts?.external) { window.open(url, "_blank", "noopener,noreferrer"); return; }
    if (opts?.download) {
      const a = document.createElement("a");
      a.href = url; a.download = "";
      document.body.appendChild(a); a.click(); a.remove();
      return;
    }
    location.href = url;
  }
  const go  = (href: string): Action => () => navFallback(href);
  const ext = (href: string): Action => () => navFallback(href, { external: true });
  const dl  = (href: string): Action => () => navFallback(href, { download: true });

  const bindings: Record<string, Action> = {
    "a":  go("/readme"),
    "p":  go("/research"),
    "P":  go("/projects"),
    "n":  go("/blogs"),
    "c":  dl("/cv/cv.pdf"),
    "g":  ext("https://github.com/peterwisu"),
    "h":  go("/help"),
    "d":  go("/"),
    "uh": togglePicker,
    "ff": () => window.dispatchEvent(new CustomEvent("vim:telescope-open")),
  };

  let leaderActive = false;
  let buffer = "";
  let timer: ReturnType<typeof setTimeout> | null = null;

  function resetLeader() {
    leaderActive = false;
    buffer = "";
    if (timer) { clearTimeout(timer); timer = null; }
  }

  function isTyping(target: EventTarget | null) {
    if (!(target instanceof HTMLElement)) return false;
    const tag = target.tagName;
    return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || target.isContentEditable;
  }

  document.addEventListener(
    "keydown",
    (e) => {
      if ((window as any).__vimCmdMode) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (isTyping(e.target)) return;

      if (!leaderActive) {
        if (e.key === " ") {
          e.preventDefault();
          e.stopImmediatePropagation();
          leaderActive = true;
          buffer = "";
          timer = setTimeout(resetLeader, 1500);
        }
        return;
      }

      // Leader is active — claim the event so other handlers (dashboard nav) don't fire.
      e.preventDefault();
      e.stopImmediatePropagation();

      if (e.key === "Escape") {
        resetLeader();
        return;
      }

      if (e.key.length !== 1) return;
      buffer += e.key;

      if (buffer in bindings) {
        const action = bindings[buffer];
        resetLeader();
        action();
        return;
      }

      const stillReachable = Object.keys(bindings).some((k) => k.startsWith(buffer));
      if (!stillReachable) resetLeader();
    },
    { capture: true }
  );
</script>
