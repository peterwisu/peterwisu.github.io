---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../config";

const aboutEntry = await getEntry("about", "index");
if (!aboutEntry) throw new Error("Missing src/content/about/index.md");
const { Content } = await render(aboutEntry);
const about = aboutEntry.data;

const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function fmtNewsDate(d: Date) {
  return d.toISOString().slice(0, 7); // YYYY-MM
}

// Group by role so repeated entries read "Reviewer  AAAI 2026 · EMNLP 2026"
// rather than listing the same role on consecutive lines.
function groupByRole<T extends { role: string }>(rows: T[], key: keyof T) {
  const out: { role: string; items: string[] }[] = [];
  for (const r of rows) {
    const existing = out.find((g) => g.role === r.role);
    if (existing) existing.items.push(String(r[key]));
    else out.push({ role: r.role, items: [String(r[key])] });
  }
  return out;
}

// Project write-ups, newest first, so the landing page points at the work
// itself rather than only the one-line news entries.
const projects = SITE_CONFIG.showProjects
  ? (await getCollection("projects", ({ data }) => !data.draft)).sort(
      (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
    )
  : [];

const serviceByRole = groupByRole(about.service, "venue");
const teachingByRole = groupByRole(about.teaching, "module");

const SOCIAL_LABEL: Record<string, string> = {
  github: "GitHub",
  x: "X / Twitter",
  twitter: "X / Twitter",
  linkedin: "LinkedIn",
};
---

<BaseLayout>
  <article class="prose">
    <h1>About me</h1>

    {about.avatar && (
      <img
        src={about.avatar}
        alt={about.name}
        width="120"
        height="120"
        loading="lazy"
        referrerpolicy="no-referrer"
        style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%; margin-bottom: 1.75rem;"
      />
    )}

    <Content />

    {about.research_interests.length > 0 && (
      <>
        <h2>Research interests</h2>
        <ul>
          {about.research_interests.map((r) => <li>{r}</li>)}
        </ul>
      </>
    )}

    {news.length > 0 && (
      <>
        <h2>News</h2>
        <ul style="list-style: none; padding-left: 0;">
          {news.map((n) => (
            <li style="display: flex; gap: 1rem; margin: 0.4rem 0;">
              <span class="text-comment" style="flex-shrink: 0; width: 5rem; font-size: 0.8rem;">{fmtNewsDate(n.data.date)}</span>
              <span>{n.data.text}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    {projects.length > 0 && (
      <>
        <h2>Selected work</h2>
        <ul style="list-style: none; padding-left: 0;">
          {projects.map((p) => (
            <li style="margin-bottom: 1.1rem;">
              <a href={`/projects/${p.id}`} style="font-weight: 600;">
                {p.data.icon && <span style="margin-right: 0.35rem;">{p.data.icon}</span>}
                {p.data.title}
              </a>
              <div class="text-fg-dark" style="font-size: 0.85rem; margin-top: 0.25rem;">
                {p.data.description}
              </div>
              {p.data.venue && (
                <div class="text-comment" style="font-size: 0.75rem; margin-top: 0.2rem;">
                  {p.data.venue}
                </div>
              )}
            </li>
          ))}
        </ul>
        <p style="margin-top: 1rem;">
          <a href="/research">See all research →</a>
        </p>
      </>
    )}

    {teachingByRole.length > 0 && (
      <>
        <h2>Teaching</h2>
        <ul style="list-style: none; padding-left: 0;">
          {teachingByRole.map((g) => (
            <li style="display: flex; gap: 1rem; margin: 0.4rem 0;">
              <span class="text-comment" style="flex-shrink: 0; width: 9rem; font-size: 0.8rem;">{g.role}</span>
              <span>{g.items.join(" · ")}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    {serviceByRole.length > 0 && (
      <>
        <h2>Service</h2>
        <ul style="list-style: none; padding-left: 0;">
          {serviceByRole.map((g) => (
            <li style="display: flex; gap: 1rem; margin: 0.3rem 0;">
              <span class="text-comment" style="flex-shrink: 0; width: 6rem; font-size: 0.8rem;">{g.role}</span>
              <span>{g.items.join(" · ")}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    {about.social.length > 0 && (
      <>
        <h2>Elsewhere</h2>
        <ul style="list-style: none; padding-left: 0;">
          {about.social.map((s) => (
            <li style="display: flex; gap: 1rem; margin: 0.3rem 0;">
              <span class="text-comment" style="flex-shrink: 0; width: 6rem; font-size: 0.8rem;">{SOCIAL_LABEL[s.platform] ?? s.platform}</span>
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.handle}</a>
            </li>
          ))}
        </ul>
      </>
    )}

    {about.contact.length > 0 && (
      <>
        <h2>Contact</h2>
        <ul style="list-style: none; padding-left: 0;">
          {about.contact.map((c) => (
            <li style="display: flex; gap: 1rem; margin: 0.3rem 0;">
              <span class="text-comment" style="flex-shrink: 0; width: 6rem; font-size: 0.8rem;">{c.label}</span>
              <a href={c.href}>{c.value}</a>
            </li>
          ))}
        </ul>
      </>
    )}

    {about.cv && (
      <>
        <h2>CV</h2>
        <p><a href="/cv">View curriculum vitae →</a></p>
      </>
    )}
  </article>
</BaseLayout>
