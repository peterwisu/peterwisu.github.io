---
import { getCollection, render } from "astro:content";
import NvimLayout from "../../layouts/NvimLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function fmtDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<NvimLayout activeFile="/blogs" fileType="markdown" mode="NORMAL" title={`Wish | ${post.data.title}`}>
  <article class="buffer-prose">
    <div class="text-comment text-xs font-mono">{fmtDate(post.data.date)}</div>
    <h1 class="!mt-2">{post.data.title}</h1>
    {post.data.summary && (
      <p class="text-fg-dark italic !mt-2">{post.data.summary}</p>
    )}
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="mt-3 flex gap-2 text-[11px] flex-wrap">
        {post.data.tags.map((t) => (
          <span class="text-purple bg-bg-highlight px-2 py-0.5 rounded font-medium">#{t}</span>
        ))}
      </div>
    )}
    <div class="mt-8">
      <Content />
    </div>
    <p class="text-comment text-xs mt-12">
      <a href="/blogs" class="text-cyan hover:underline">← back to blogs/</a>
    </p>
  </article>
</NvimLayout>
