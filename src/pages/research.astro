---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const all = await getCollection("publications", ({ data }) => !data.draft);

const preprints = all
  .filter((p) => p.data.preprint)
  .sort((a, b) => b.data.year - a.data.year);

const publications = all.filter((p) => !p.data.preprint);

const groups: Record<number, typeof publications> = {};
for (const p of publications) {
  (groups[p.data.year] ??= []).push(p);
}
const years = Object.keys(groups).map(Number).sort((a, b) => b - a);

function isMe(name: string) {
  return /suharitdamrong/i.test(name);
}

interface Link { label: string; href: string }
function buildLinks(data: {
  pdf?: string; code?: string; arxiv?: string; bibtex?: string; project?: string;
}): Link[] {
  const links: Link[] = [];
  if (data.arxiv)   links.push({ label: "arXiv",   href: data.arxiv });
  if (data.pdf)     links.push({ label: "PDF",     href: data.pdf });
  if (data.code)    links.push({ label: "code",    href: data.code });
  if (data.project) links.push({ label: "project", href: data.project });
  if (data.bibtex)  links.push({ label: "bibtex",  href: data.bibtex });
  return links;
}
---

<BaseLayout title="Research">
  <article class="prose">
    <h1>Research</h1>

    {years.length > 0 && years.map((y) => (
      <section>
        <h2>{y}</h2>
        <ul style="list-style: none; padding-left: 0;">
          {groups[y].map((p) => (
            <li style="margin-bottom: 1.6rem;">
              <div style="font-weight: 600; line-height: 1.4;">{p.data.title}</div>
              <div class="text-fg-dark" style="font-size: 0.85rem; margin-top: 0.25rem;">
                {p.data.authors.map((name, i) => (
                  <>
                    {isMe(name) ? <strong>{name}</strong> : <span>{name}</span>}
                    {i < p.data.authors.length - 1 && <span>, </span>}
                  </>
                ))}
              </div>
              <div class="text-comment" style="font-size: 0.8rem; font-style: italic; margin-top: 0.2rem;">{p.data.venue}, {p.data.year}</div>
              {buildLinks(p.data).length > 0 && (
                <div style="margin-top: 0.4rem; display: flex; gap: 0.9rem; font-size: 0.78rem;">
                  {buildLinks(p.data).map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    {preprints.length > 0 && (
      <section>
        <h2>Preprints</h2>
        <ul style="list-style: none; padding-left: 0;">
          {preprints.map((p) => (
            <li style="margin-bottom: 1.6rem;">
              <div style="font-weight: 600; line-height: 1.4;">{p.data.title}</div>
              <div class="text-fg-dark" style="font-size: 0.85rem; margin-top: 0.25rem;">
                {p.data.authors.map((name, i) => (
                  <>
                    {isMe(name) ? <strong>{name}</strong> : <span>{name}</span>}
                    {i < p.data.authors.length - 1 && <span>, </span>}
                  </>
                ))}
              </div>
              <div class="text-comment" style="font-size: 0.8rem; font-style: italic; margin-top: 0.2rem;">{p.data.venue}</div>
              {buildLinks(p.data).length > 0 && (
                <div style="margin-top: 0.4rem; display: flex; gap: 0.9rem; font-size: 0.78rem;">
                  {buildLinks(p.data).map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {years.length === 0 && preprints.length === 0 && (
      <p class="text-comment">No publications listed yet.</p>
    )}
  </article>
</BaseLayout>
