---
import NvimLayout from "../layouts/NvimLayout.astro";

interface Row { key: string; desc: string; }

const leader: Row[] = [
  { key: "SPC a",     desc: "Open About (README.md)" },
  { key: "SPC p",     desc: "Open Research (preprints + publications)" },
  { key: "SPC P",     desc: "Open Projects" },
  { key: "SPC n",     desc: "Open Blog" },
  { key: "SPC c",     desc: "Download CV" },
  { key: "SPC g",     desc: "Open GitHub (peterwisu)" },
  { key: "SPC h",     desc: "Open Help" },
  { key: "SPC d",     desc: "Back to Home (dashboard)" },
  { key: "SPC u h",   desc: "Open theme picker" },
  { key: "SPC f f",   desc: "Open Telescope (fuzzy file finder)" },
];

const buffer: Row[] = [
  { key: "j  / ↓",    desc: "Next block (down)" },
  { key: "k  / ↑",    desc: "Previous block (up)" },
  { key: "2j, 3k",    desc: "Count prefix — repeat motion N times" },
  { key: "l / Enter / →", desc: "Activate (follow first link in current block)" },
  { key: "h / ←",     desc: "(buffer) no-op  ·  (tree) go back to buffer" },
  { key: "gg / b",    desc: "Jump to first block" },
  { key: "G  / e",    desc: "Jump to last block" },
  { key: "Ctrl-d",    desc: "Scroll half-page down" },
  { key: "Ctrl-u",    desc: "Scroll half-page up" },
  { key: "q",         desc: "Back to Dashboard" },
  { key: "Esc",       desc: "Cancel pending count / return focus to buffer" },
];

const focus: Row[] = [
  { key: ":ex / :tree",  desc: "Move focus to the file tree (cursor lives there)" },
  { key: ":buf / :buffer", desc: "Return focus to the buffer" },
  { key: "click on tree", desc: "Also focuses tree" },
  { key: "click on buffer", desc: "Also focuses buffer" },
];

const ex: Row[] = [
  { key: ":q  /  :quit  /  :home  /  :dashboard  /  :alpha", desc: "Back to / (home)" },
  { key: ":e readme  /  :e about",   desc: "Open README.md" },
  { key: ":e research  /  :e publications  /  :e pubs", desc: "Open research.bib" },
  { key: ":e projects",              desc: "Open projects.md" },
  { key: ":e blogs  /  :e blog",     desc: "Open blogs/" },
  { key: ":e help  /  :help  /  :h", desc: "Open this file" },
  { key: ":readme, :research, :projects, :blogs, …", desc: "Shorthand without :e" },
  { key: ":cv",                      desc: "Trigger CV download" },
  { key: ":gh / :github",            desc: "Open github.com/peterwisu" },
  { key: ":set number  /  :set nu",  desc: "Show line numbers" },
  { key: ":set nonumber  /  :set nonu", desc: "Hide line numbers" },
  { key: ":Telescope  /  :tel  /  :ff", desc: "Open the fuzzy file finder" },
];

function renderTable(rows: Row[]) {
  return rows;
}
---

<NvimLayout activeFile="/help" fileType="help" mode="NORMAL" title="Wish | Help">
  <article class="buffer-prose" style="max-width: 900px;">
    <h1>help.txt</h1>
    <p class="text-comment">
      Keybinding reference for this site. Same idea as <code>:help</code> in Neovim.
      Navigate with <code>j</code>/<code>k</code>, hit <code>:q</code> to exit.
    </p>

    <h2>About this site</h2>
    <p>
      This is a personal website built to look and feel like
      <a href="https://neovim.io" target="_blank" rel="noopener noreferrer">Neovim</a> running with
      a <a href="https://www.lazyvim.org" target="_blank" rel="noopener noreferrer">LazyVim</a>-style
      dashboard.
    </p>
    <p class="text-fg-dark text-sm">
      Built because my fingers refuse to leave <code>hjkl</code> and the rest of Vim motion —
      even though I'm no Vim wizard. (Daily driver: VSCode with the Vim plugin — real Neovim only
      for small projects.) If you've ever struggled to exit Vim — I was once there. 100% vibe-coded with
      <a href="https://claude.com/claude-code" target="_blank" rel="noopener noreferrer">Claude Code</a>;
      tildes, fake boot screen, and ex-command parser included free of charge.
    </p>
    <p>
      The landing page mimics the <code>:Alpha</code> screen; every other page is rendered inside a
      fake editor window — file tree on the left, status line at the bottom, tildes down the gutter
      where the buffer ends.
    </p>
    <p>
      Because the site borrows the editor's UI, it also borrows its <em>controls</em>. You can navigate
      with <code>j</code>/<code>k</code>/<code>l</code>/<code>h</code>, jump with <code>gg</code> and
      <code>G</code>, prefix motions with a count (<code>2j</code>, <code>3k</code>), open a fuzzy
      file picker with <code>SPC f f</code>, and run ex commands like <code>:e research</code>,
      <code>:q</code>, or <code>:set number</code>. <strong>This file lists every one of those
      bindings</strong> — it's the literal answer to "what can I press?", which is exactly the role
      <code>:help</code> plays inside Neovim.
    </p>
    <p class="text-fg-dark text-sm">
      Not a Vim user? You can also click links, scroll, and use the file tree like any normal site.
      The vim-style controls are an extra layer, not a requirement.
    </p>

    <h2>Leader (SPC) bindings</h2>
    <p class="text-fg-dark text-sm">
      Press <code>SPC</code> (space), then the chord letter. Works on every page.
    </p>
    <table class="help-table">
      {leader.map((r) => (
        <tr><td class="text-yellow">{r.key}</td><td>{r.desc}</td></tr>
      ))}
    </table>

    <h2>Buffer / tree navigation</h2>
    <p class="text-fg-dark text-sm">
      The active "window" (buffer or tree) catches <code>j</code>/<code>k</code>/<code>l</code>/<code>h</code>.
      The cursor is the blinking blue bar on the left of the current line.
    </p>
    <table class="help-table">
      {buffer.map((r) => (
        <tr><td class="text-yellow">{r.key}</td><td>{r.desc}</td></tr>
      ))}
    </table>

    <h2>Switching focus</h2>
    <p class="text-fg-dark text-sm">
      The buffer is focused by default. Use these to move between buffer and tree.
    </p>
    <table class="help-table">
      {focus.map((r) => (
        <tr><td class="text-yellow">{r.key}</td><td>{r.desc}</td></tr>
      ))}
    </table>

    <h2>Ex commands</h2>
    <p class="text-fg-dark text-sm">
      Press <code>:</code> to open the command line, type a command, hit Enter.
      <code>Esc</code> cancels.
    </p>
    <table class="help-table">
      {ex.map((r) => (
        <tr><td class="text-yellow">{r.key}</td><td>{r.desc}</td></tr>
      ))}
    </table>

    <h2>Theme</h2>
    <p>
      Three themes: <strong>Claude</strong> (warm retro, default), <strong>Storm</strong> (Tokyo Night dark),
      and <strong>Day</strong> (Tokyo Night light). Pick from the popover at the bottom-right of the status bar,
      or press <code>SPC u h</code>.
    </p>
  </article>
</NvimLayout>

<style>
  .help-table {
    width: 100%;
    margin: 0.75rem 0 1rem;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .help-table td {
    padding: 0.25rem 1rem 0.25rem 0;
    vertical-align: top;
  }
  .help-table td:first-child {
    white-space: nowrap;
    width: 1%;
    font-family: var(--font-mono);
  }
  .help-table td:last-child {
    color: var(--tn-fg-dark);
  }
</style>
