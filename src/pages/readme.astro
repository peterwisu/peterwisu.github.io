---
import { getCollection, getEntry, render } from "astro:content";
import NvimLayout from "../layouts/NvimLayout.astro";

const aboutEntry = await getEntry("about", "index");
if (!aboutEntry) throw new Error("Missing src/content/about/index.md");
const { Content } = await render(aboutEntry);
const about = aboutEntry.data;

const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function fmtNewsDate(d: Date) {
  return d.toISOString().slice(0, 7); // YYYY-MM
}

const SOCIAL_LABEL: Record<string, string> = {
  github: "github",
  x: "x / twitter",
  twitter: "x / twitter",
  linkedin: "linkedin",
};
---

<NvimLayout activeFile="/readme" fileType="markdown" mode="NORMAL" title="Wish | About me">
  <article class="buffer-prose">
    <h1>About me</h1>
    {about.avatar && (
      <div class="flex justify-center my-6">
        <img
          src={about.avatar}
          alt={about.name}
          width="160"
          height="160"
          loading="lazy"
          referrerpolicy="no-referrer"
          class="rounded-full object-cover border-2 border-blue"
          style="width:10rem; height:10rem; box-shadow: 0 0 24px rgba(234, 138, 61, 0.25);"
        />
      </div>
    )}

    <Content />

    {about.research_interests.length > 0 && (
      <>
        <h2>Research interests</h2>
        <ul class="text-fg list-disc pl-6 mt-3 space-y-1">
          {about.research_interests.map((r) => <li>{r}</li>)}
        </ul>
      </>
    )}

    {about.cv && (
      <>
        <h2>CV</h2>
        <p>
          <a
            href="/cv"
            class="inline-flex items-center gap-2 rounded bg-blue px-4 py-2 font-bold hover:bg-cyan transition"
            style="color: #ffffff; text-decoration: none;"
          >
            ↗ View CV
          </a>
        </p>
      </>
    )}

    {news.length > 0 && (
      <>
        <h2>News</h2>
        <ul class="text-fg list-none pl-0 mt-3 space-y-2">
          {news.map((n) => (
            <li class="flex gap-3">
              <span class="text-yellow font-mono text-sm shrink-0 w-24">{fmtNewsDate(n.data.date)}</span>
              <span>{n.data.text}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    {about.social.length > 0 && (
      <>
        <h2>Social</h2>
        <ul class="text-fg list-none pl-0 mt-3 space-y-2">
          {about.social.map((s) => (
            <li class="flex items-center gap-3">
              {s.platform === "github" && (
                <svg class="social-icon shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.07 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.6.23 2.78.11 3.07.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.13v3.16c0 .31.21.68.8.56C20.71 21.39 24 17.08 24 12 24 5.73 18.77.5 12 .5z"/>
                </svg>
              )}
              {(s.platform === "x" || s.platform === "twitter") && (
                <svg class="social-icon shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {s.platform === "linkedin" && (
                <svg class="social-icon shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
                </svg>
              )}
              <span class="text-comment font-mono text-sm shrink-0 w-20">{SOCIAL_LABEL[s.platform] ?? s.platform}</span>
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.handle}</a>
            </li>
          ))}
        </ul>
      </>
    )}

    {about.contact.length > 0 && (
      <>
        <h2>Contact</h2>
        <ul class="text-fg list-none pl-0 mt-3 space-y-1">
          {about.contact.map((c) => (
            <li class="flex gap-3">
              <span class="text-comment font-mono text-sm shrink-0 w-24">{c.label}</span>
              <a href={c.href}>{c.value}</a>
            </li>
          ))}
        </ul>
      </>
    )}
  </article>
</NvimLayout>

<style>
  .social-icon {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--tn-blue);
  }
</style>
