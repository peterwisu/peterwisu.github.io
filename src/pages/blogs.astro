---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../config";

const posts = SITE_CONFIG.showBlog
  ? (await getCollection("blog", ({ data }) => !data.draft)).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime()
    )
  : [];

function fmtDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<BaseLayout title="Blog">
  <article class="prose">
    <h1>Blog</h1>

    {!SITE_CONFIG.showBlog ? (
      <p class="text-comment">The blog is not available right now.</p>
    ) : posts.length === 0 ? (
      <p class="text-comment">No posts yet.</p>
    ) : (
      <ul style="list-style: none; padding-left: 0;">
        {posts.map((p) => (
          <li style="margin-bottom: 1.4rem;">
            <a href={`/blogs/${p.id}`} class="no-underline">
              <div class="text-comment" style="font-size: 0.75rem;">{fmtDate(p.data.date)}</div>
              <div style="font-weight: 600; margin-top: 0.2rem;">{p.data.title}</div>
              {p.data.summary && (
                <div class="text-fg-dark" style="font-size: 0.85rem; margin-top: 0.2rem;">{p.data.summary}</div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>
